# ===========================================
# REGISTRE VIRTUEL EU - Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=registre_virtuel
DB_USER=root
DB_PASS=

# JWT Authentication
JWT_SECRET=votre_secret_jwt_super_securise_a_changer
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
